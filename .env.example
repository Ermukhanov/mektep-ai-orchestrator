# Copy this file to .env and fill secrets locally (DO NOT commit .env)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_USE_MOCK=true

# Alem.ai LLM (set your key here locally)
ALEM_API_KEY=put-your-alem-api-key-here

# (Optional) Mirror env for Vite if you need client-only calls (not recommended):
# VITE_ALEM_API_KEY=put-your-key-here

# Other optional keys
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
KITCHEN_WHATSAPP_TO=
TWILIO_WHATSAPP_FROM=
